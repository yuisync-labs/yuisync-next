{
  "name": "yuisync",
  "version": "1.0.0",
  "description": "CRM completo - Supabase + OpenAI + React",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-vite.mjs",
    "api": "node server/index.js",
    "start": "concurrently \"npm run api\" \"npm run dev\"",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:petbot": "node scripts/run-node-tests.mjs test/petbotAgent.test.mjs test/petbotAgentV3.test.mjs test/petbotFlowMatrix.test.mjs test/petbotModes.test.mjs test/petbotSemantics.test.mjs test/petbotStatic.test.mjs test/serverlessChatIngestionStatic.test.mjs test/petshopOperations.test.mjs test/prePr61Static.test.mjs test/prePr61Agent.test.mjs",
    "test:transactions": "node --test test/transactionalStatic.test.mjs test/agendaOperationalInfrastructure.test.mjs test/operationalServicePolicy.test.mjs",
    "test:e2e": "playwright test",
    "test:tenant": "node scripts/test-tenant-isolation.mjs",
    "test:all": "npm run typecheck && npm run typecheck:contracts && npm run check:contract-boundaries && npm run check:product-ui && npm run test:contracts && npm run test && npm run test:petbot && npm run test:luna && npm run test:transactions && npm run edge:check && npm run build",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test:petbot:legacy": "node --test test/petbotGuard.test.mjs",
    "test:petbot:live": "node scripts/eval-petbot-agent.mjs",
    "test:petbot:live-chat": "node --env-file=.env scripts/test-petbot-live-conversations.mjs --run",
    "test:petbot:matrix": "node --test test/petbotFlowMatrix.test.mjs",
    "test:luna:unit": "node --test test/luna/*.test.mjs",
    "test:luna:regressions": "node scripts/run-luna-scenarios.mjs",
    "test:luna": "npm run test:luna:unit && npm run test:luna:regressions && npm run test:luna:eval",
    "audit:ci": "node scripts/check-npm-audit.mjs",
    "luna:fixture:export": "node scripts/export-luna-trace-fixture.mjs",
    "luna:trace:replay": "node scripts/replay-luna-trace.mjs",
    "test:luna:foundation": "node --test test/luna/errors.test.mjs test/luna/toolRegistry.test.mjs test/luna/runtime.test.mjs test/luna/traceFixture.test.mjs test/luna/temporaryOperationStore.test.mjs test/luna/factualRenderer.test.mjs test/luna/foundationIntegration.test.mjs test/luna/ciPolicy.test.mjs test/luna/evalPlatform.test.mjs test/luna/evalApiStatic.test.mjs",
    "luna:eval:compile": "node scripts/compile-luna-scenarios.mjs",
    "luna:eval:run": "node scripts/run-luna-evals.mjs",
    "luna:eval:replay": "node scripts/replay-luna-eval.mjs",
    "luna:eval:impact": "node scripts/select-luna-evals.mjs",
    "test:luna:eval": "node scripts/run-luna-evals.mjs",
    "test:luna:eval:full": "node scripts/run-luna-evals.mjs --groups all --max-cases 500",
    "test:luna:eval:contracts": "node --test test/luna/evalPlatform.test.mjs test/luna/evalApiStatic.test.mjs",
    "test:luna:eval:ci": "npm run test:luna:eval:contracts && npm run test:luna:eval",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json --noEmit",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "check:contract-boundaries": "node scripts/check-contract-boundaries.mjs",
    "check:product-ui": "node scripts/check-product-ui-boundaries.mjs",
    "check:no-domain-state-from-dom": "node scripts/check-no-domain-state-from-dom.mjs",
    "check:appointment-edit-semantics": "node scripts/check-appointment-edit-semantics.mjs",
    "check:planos-native-commands": "node scripts/check-planos-native-commands.mjs",
    "check:no-runtime-supabase": "node scripts/check-no-runtime-supabase.mjs",
    "check:edge-compat-surface": "node scripts/check-edge-compat-surface.mjs",
    "check:whatsapp-edge-boundaries": "node scripts/check-whatsapp-edge-boundaries.mjs",
    "edge:types": "npm run types --workspace @yuisync/edge-api",
    "edge:types:check": "npm run types:check --workspace @yuisync/edge-api",
    "edge:typecheck": "npm run typecheck --workspace @yuisync/edge-api",
    "edge:test": "npm run test --workspace @yuisync/edge-api",
    "edge:dry-run": "npm run build && npm run deploy:dry-run --workspace @yuisync/edge-api",
    "edge:check": "npm run edge:types:check && npm run edge:typecheck && npm run edge:test && npm run edge:dry-run",
    "edge:dev": "npm run dev --workspace @yuisync/edge-api",
    "edge:smoke": "node scripts/smoke-edge-staging.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.383.0",
    "luxon": "^3.7.2",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "read-excel-file": "9.3.5",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "main": "postcss.config.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "undici": "7.29.0",
    "nanoid": "3.3.18"
  }
}
